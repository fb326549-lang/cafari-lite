<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Candidate entitlement path for iOS 26.3: audio only.
       Apple states CarPlay audio/video entitlements cannot be combined
       on iOS 26.3+. This key must still be granted by Apple to the team.
       The browser and any video playback must comply with Apple's review rules. -->
  <key>com.apple.developer.carplay-audio</key>
  <true/>
</dict>
</plist>
